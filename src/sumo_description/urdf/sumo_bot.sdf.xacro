<?xml version="1.0"?>

<sdf version="1.8" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="name" default="team1"/>
  <xacro:arg name="color" default="red"/>

  <xacro:property name="colors" value="${dict(
      red='0.86 0.08 0.1 1', blue='0.08 0.36 0.9 1', green='0.08 0.7 0.28 1',
      yellow='0.98 0.78 0.05 1', orange='1.0 0.45 0.05 1', purple='0.58 0.2 0.85 1',
      cyan='0.0 0.75 0.8 1')}"/>
  <xacro:property name="team" value="${colors['$(arg color)']}"/>
  <xacro:property name="white" value="0.93 0.94 0.96 1"/>
  <xacro:property name="graphite" value="0.16 0.17 0.2 1"/>
  <xacro:property name="joint_grey" value="0.5 0.52 0.56 1"/>
  <xacro:property name="visor_black" value="0.03 0.04 0.06 1"/>
  <xacro:property name="glow" value="0.2 0.95 1.0 1"/>
  <xacro:property name="angry" value="1.0 0.08 0.02 1"/>
  <xacro:property name="head_z" value="0.64"/>

  <xacro:property name="wheel_r" value="0.10"/>
  <xacro:property name="wheel_w" value="0.06"/>
  <xacro:property name="wheel_y" value="0.33"/>
  <xacro:property name="base_r" value="0.30"/>
  <xacro:property name="shoulder_y" value="0.25"/>
  <xacro:property name="shoulder_z" value="0.45"/>
  <xacro:property name="upper_len" value="0.22"/>
  <xacro:property name="fore_len" value="0.18"/>
  <xacro:property name="guard_shoulder" value="-0.4"/>
  <xacro:property name="guard_elbow" value="-1.8"/>

  <xacro:macro name="paint" params="rgba rough:=0.35 metal:=0.1">
    <material>
      <ambient>${rgba}</ambient><diffuse>${rgba}</diffuse><specular>0.5 0.5 0.5 1</specular>
      <pbr><metal><metalness>${metal}</metalness><roughness>${rough}</roughness></metal></pbr>
    </material>
  </xacro:macro>
  <xacro:macro name="light" params="rgba">
    <material>
      <ambient>${rgba}</ambient><diffuse>${rgba}</diffuse><emissive>${rgba}</emissive>
    </material>
  </xacro:macro>

  <xacro:macro name="v_sphere" params="vname pose r rgba">
    <visual name="${vname}"><pose>${pose}</pose>
      <geometry><sphere><radius>${r}</radius></sphere></geometry><xacro:paint rgba="${rgba}"/></visual>
  </xacro:macro>
  <xacro:macro name="v_ellipsoid" params="vname pose radii rgba rough:=0.35">
    <visual name="${vname}"><pose>${pose}</pose>
      <geometry><ellipsoid><radii>${radii}</radii></ellipsoid></geometry><xacro:paint rgba="${rgba}" rough="${rough}"/></visual>
  </xacro:macro>
  <xacro:macro name="v_cyl" params="vname pose r length rgba">
    <visual name="${vname}"><pose>${pose}</pose>
      <geometry><cylinder><radius>${r}</radius><length>${length}</length></cylinder></geometry><xacro:paint rgba="${rgba}"/></visual>
  </xacro:macro>
  <xacro:macro name="v_capsule" params="vname pose r length rgba">
    <visual name="${vname}"><pose>${pose}</pose>
      <geometry><capsule><radius>${r}</radius><length>${length}</length></capsule></geometry><xacro:paint rgba="${rgba}"/></visual>
  </xacro:macro>
  <xacro:macro name="v_box" params="vname pose size rgba">
    <visual name="${vname}"><pose>${pose}</pose>
      <geometry><box><size>${size}</size></box></geometry><xacro:paint rgba="${rgba}"/></visual>
  </xacro:macro>
  <xacro:macro name="v_light_cyl" params="vname pose r length rgba">
    <visual name="${vname}"><pose>${pose}</pose>
      <geometry><cylinder><radius>${r}</radius><length>${length}</length></cylinder></geometry><xacro:light rgba="${rgba}"/></visual>
  </xacro:macro>
  <xacro:macro name="v_light_ellipsoid" params="vname pose radii rgba">
    <visual name="${vname}"><pose>${pose}</pose>
      <geometry><ellipsoid><radii>${radii}</radii></ellipsoid></geometry><xacro:light rgba="${rgba}"/></visual>
  </xacro:macro>

  <xacro:macro name="box_inertial" params="m x y z pose:='0 0 0 0 0 0'">
    <inertial>
      <pose>${pose}</pose>
      <mass>${m}</mass>
      <inertia>
        <ixx>${m * (y*y + z*z) / 12}</ixx><iyy>${m * (x*x + z*z) / 12}</iyy><izz>${m * (x*x + y*y) / 12}</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
      </inertia>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <pose>0 ${y} 0 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.0028</ixx><iyy>0.005</iyy><izz>0.0028</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <xacro:v_cyl vname="tyre" pose="0 0 0 1.5707963 0 0" r="${wheel_r}" length="${wheel_w}" rgba="${graphite}"/>
      <xacro:v_cyl vname="rim" pose="0 0 0 1.5707963 0 0" r="0.07" length="${wheel_w + 0.004}" rgba="${white}"/>
      <xacro:v_cyl vname="hub" pose="0 0 0 1.5707963 0 0" r="0.035" length="${wheel_w + 0.01}" rgba="${team}"/>
      <collision name="collision">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><cylinder><radius>${wheel_r}</radius><length>${wheel_w}</length></cylinder></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
    </link>
    <joint name="${side}_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>${side}_wheel</child>
      <axis><xyz>0 1 0</xyz></axis>
    </joint>
  </xacro:macro>

  <xacro:macro name="arm" params="side y">
    <link name="${side}_upper_arm">
      <pose>0 ${y} ${shoulder_z} 0 0 0</pose>
      <xacro:box_inertial m="0.6" x="0.07" y="0.07" z="${upper_len}" pose="0 0 ${-upper_len / 2} 0 0 0"/>
      <xacro:v_sphere vname="shoulder_pad" pose="0 0 0 0 0 0" r="0.075" rgba="${team}"/>
      <xacro:v_capsule vname="upper_arm" pose="0 0 ${-upper_len / 2} 0 0 0" r="0.035" length="${upper_len - 0.07}" rgba="${white}"/>
      <collision name="upper_collision">
        <pose>0 0 ${-upper_len / 2} 0 0 0</pose>
        <geometry><box><size>0.07 0.07 ${upper_len}</size></box></geometry>
      </collision>
    </link>
    <link name="${side}_forearm">
      <pose>0 ${y} ${shoulder_z - upper_len} 0 0 0</pose>
      <xacro:box_inertial m="0.5" x="0.065" y="0.065" z="${fore_len}" pose="0 0 ${-fore_len / 2} 0 0 0"/>
      <xacro:v_sphere vname="elbow" pose="0 0 0 0 0 0" r="0.045" rgba="${joint_grey}"/>
      <xacro:v_capsule vname="forearm" pose="0 0 ${-fore_len / 2 + 0.01} 0 0 0" r="0.034" length="${fore_len - 0.08}" rgba="${white}"/>
      <xacro:v_cyl vname="cuff" pose="0 0 ${-fore_len + 0.02} 0 0 0" r="0.048" length="0.035" rgba="${white}"/>
      <xacro:v_ellipsoid vname="glove" pose="0 0 ${-fore_len - 0.04} 0 0 0" radii="0.068 0.062 0.072" rgba="${team}" rough="0.25"/>
      <collision name="forearm_collision">
        <pose>0 0 ${-fore_len / 2} 0 0 0</pose>
        <geometry><box><size>0.065 0.065 ${fore_len}</size></box></geometry>
      </collision>
      <collision name="glove_collision">
        <pose>0 0 ${-fore_len - 0.04} 0 0 0</pose>
        <geometry><sphere><radius>0.065</radius></sphere></geometry>
      </collision>
    </link>
    <joint name="${side}_shoulder" type="revolute">
      <parent>base_link</parent>
      <child>${side}_upper_arm</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-3.0</lower><upper>0.5</upper><effort>60</effort><velocity>8</velocity></limit>
        <dynamics><damping>0.5</damping></dynamics>
      </axis>
    </joint>
    <joint name="${side}_elbow" type="revolute">
      <parent>${side}_upper_arm</parent>
      <child>${side}_forearm</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-2.4</lower><upper>0.0</upper><effort>40</effort><velocity>8</velocity></limit>
        <dynamics><damping>0.3</damping></dynamics>
      </axis>
    </joint>
    <xacro:arm_controller joint="${side}_shoulder" initial="${guard_shoulder}" p="80" d="4" effort="60"/>
    <xacro:arm_controller joint="${side}_elbow" initial="${guard_elbow}" p="40" d="2" effort="40"/>
  </xacro:macro>

  <xacro:macro name="arm_controller" params="joint initial p d effort">
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>${joint}</joint_name>
      <topic>/model/$(arg name)/arm/${joint}</topic>
      <initial_position>${initial}</initial_position>
      <p_gain>${p}</p_gain>
      <i_gain>0.5</i_gain>
      <d_gain>${d}</d_gain>
      <i_max>5</i_max>
      <i_min>-5</i_min>
      <cmd_max>${effort}</cmd_max>
      <cmd_min>${-effort}</cmd_min>
    </plugin>
  </xacro:macro>

  <model name="$(arg name)">

    <link name="base_link">
      <xacro:box_inertial m="22.0" x="0.6" y="0.5" z="0.3" pose="0 0 0.08 0 0 0"/>

      <xacro:v_cyl vname="pod" pose="0 0 0.03 0 0 0" r="${base_r}" length="0.10" rgba="${graphite}"/>
      <xacro:v_cyl vname="stripe" pose="0 0 0.035 0 0 0" r="${base_r + 0.004}" length="0.022" rgba="${team}"/>
      <xacro:v_cyl vname="deck" pose="0 0 0.088 0 0 0" r="${base_r - 0.03}" length="0.016" rgba="${white}"/>
      <xacro:v_box vname="wedge" pose="${base_r + 0.012} 0 -0.03 0 1.0 0" size="0.075 0.40 0.014" rgba="${team}"/>
      <xacro:v_light_cyl vname="headlight_l" pose="${base_r - 0.005} 0.12 0.055 0 1.5707963 0" r="0.016" length="0.012" rgba="0.95 0.95 0.85 1"/>
      <xacro:v_light_cyl vname="headlight_r" pose="${base_r - 0.005} -0.12 0.055 0 1.5707963 0" r="0.016" length="0.012" rgba="0.95 0.95 0.85 1"/>
      <xacro:v_light_cyl vname="taillight_l" pose="${-base_r + 0.005} 0.12 0.055 0 1.5707963 0" r="0.014" length="0.012" rgba="1.0 0.1 0.1 1"/>
      <xacro:v_light_cyl vname="taillight_r" pose="${-base_r + 0.005} -0.12 0.055 0 1.5707963 0" r="0.014" length="0.012" rgba="1.0 0.1 0.1 1"/>
      <collision name="pod_collision">
        <pose>0 0 0.03 0 0 0</pose>
        <geometry><cylinder><radius>${base_r}</radius><length>0.10</length></cylinder></geometry>
      </collision>

      <collision name="bumper_collision">
        <pose>${base_r - 0.01} 0 0.03 0 0 0</pose>
        <geometry><box><size>0.06 0.44 0.10</size></box></geometry>
      </collision>

      <xacro:v_cyl vname="waist" pose="0 0 0.13 0 0 0" r="0.09" length="0.07" rgba="${joint_grey}"/>
      <xacro:v_ellipsoid vname="chest" pose="0 0 0.33 0 0 0" radii="0.15 0.19 0.19" rgba="${white}" rough="0.3"/>
      <xacro:v_cyl vname="belt" pose="0 0 0.19 0 0 0" r="0.12" length="0.035" rgba="${team}"/>
      <xacro:v_cyl vname="core_ring" pose="0.142 0 0.36 0 1.5707963 0" r="0.06" length="0.03" rgba="${joint_grey}"/>
      <xacro:v_light_cyl vname="core" pose="0.158 0 0.36 0 1.5707963 0" r="0.045" length="0.012" rgba="${team}"/>
      <collision name="chest_collision">
        <pose>0 0 0.32 0 0 0</pose>
        <geometry><box><size>0.28 0.36 0.38</size></box></geometry>
      </collision>

      <xacro:v_cyl vname="neck" pose="0 0 0.53 0 0 0" r="0.045" length="0.05" rgba="${joint_grey}"/>
      <xacro:v_ellipsoid vname="helmet" pose="0 0 ${head_z} 0 0 0" radii="0.12 0.135 0.11" rgba="${white}" rough="0.25"/>
      <xacro:v_ellipsoid vname="visor" pose="0.072 0 0.637 0 0 0" radii="0.062 0.112 0.07" rgba="${visor_black}" rough="0.1"/>
      <xacro:v_cyl vname="headphone_l" pose="0 0.135 ${head_z} 1.5707963 0 0" r="0.088" length="0.035" rgba="${graphite}"/>
      <xacro:v_cyl vname="headphone_r" pose="0 -0.135 ${head_z} 1.5707963 0 0" r="0.088" length="0.035" rgba="${graphite}"/>
      <xacro:v_cyl vname="headphone_cap_l" pose="0 0.154 ${head_z} 1.5707963 0 0" r="0.06" length="0.006" rgba="${team}"/>
      <xacro:v_cyl vname="headphone_cap_r" pose="0 -0.154 ${head_z} 1.5707963 0 0" r="0.06" length="0.006" rgba="${team}"/>
      <xacro:v_cyl vname="antenna" pose="-0.02 0 0.78 0 0 0" r="0.007" length="0.08" rgba="${joint_grey}"/>
      <visual name="antenna_light"><pose>-0.02 0 0.83 0 0 0</pose>
        <geometry><sphere><radius>0.022</radius></sphere></geometry><xacro:light rgba="${team}"/></visual>
      <collision name="head_collision">
        <pose>0 0 0.64 0 0 0</pose>
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
      </collision>

      <collision name="caster_front">
        <pose>0.22 0 -0.05 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
      <collision name="caster_back">
        <pose>-0.22 0 -0.05 0 0 0</pose>
        <geometry><sphere><radius>0.045</radius></sphere></geometry>
        <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="face">
      <pose>0 0 ${head_z} 0 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <xacro:v_light_ellipsoid vname="happy_eye_l" pose="0.128 0.045 0.008 0 0 0" radii="0.008 0.022 0.028" rgba="${glow}"/>
      <xacro:v_light_ellipsoid vname="happy_eye_r" pose="0.128 -0.045 0.008 0 0 0" radii="0.008 0.022 0.028" rgba="${glow}"/>
      <xacro:v_light_ellipsoid vname="happy_mouth" pose="0.126 0 -0.035 0 0 0" radii="0.006 0.024 0.006" rgba="${glow}"/>
      <xacro:v_light_ellipsoid vname="angry_eye_l" pose="-0.045 0.129 0.0 0 0 1.5707963" radii="0.008 0.024 0.014" rgba="${angry}"/>
      <xacro:v_light_ellipsoid vname="angry_eye_r" pose="0.045 0.129 0.0 0 0 1.5707963" radii="0.008 0.024 0.014" rgba="${angry}"/>
      <visual name="angry_brow_l"><pose>-0.042 0.122 0.036 0.45 0 1.5707963</pose>
        <geometry><box><size>0.006 0.045 0.011</size></box></geometry><xacro:light rgba="${angry}"/></visual>
      <visual name="angry_brow_r"><pose>0.042 0.122 0.036 -0.45 0 1.5707963</pose>
        <geometry><box><size>0.006 0.045 0.011</size></box></geometry><xacro:light rgba="${angry}"/></visual>
      <xacro:v_light_ellipsoid vname="angry_mouth" pose="0 0.126 -0.04 0 0 1.5707963" radii="0.006 0.03 0.005" rgba="${angry}"/>
    </link>
    <joint name="face_joint" type="revolute">
      <parent>base_link</parent>
      <child>face</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1.6</lower><upper>0.05</upper><effort>2</effort><velocity>10</velocity></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>
    <plugin filename="ignition-gazebo-joint-position-controller-system"
            name="ignition::gazebo::systems::JointPositionController">
      <joint_name>face_joint</joint_name>
      <topic>/model/$(arg name)/face</topic>
      <initial_position>0.0</initial_position>
      <p_gain>0.5</p_gain>
      <d_gain>0.05</d_gain>
      <cmd_max>2</cmd_max>
      <cmd_min>-2</cmd_min>
    </plugin>

    <xacro:wheel side="left" y="${wheel_y}"/>
    <xacro:wheel side="right" y="${-wheel_y}"/>
    <xacro:arm side="left" y="${shoulder_y}"/>
    <xacro:arm side="right" y="${-shoulder_y}"/>

    <plugin filename="ignition-gazebo-diff-drive-system"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${2 * wheel_y}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_velocity>1.5</max_linear_velocity>
      <min_linear_velocity>-1.5</min_linear_velocity>
      <max_angular_velocity>4.0</max_angular_velocity>
      <min_angular_velocity>-4.0</min_angular_velocity>
      <max_linear_acceleration>4.0</max_linear_acceleration>
      <min_linear_acceleration>-6.0</min_linear_acceleration>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
