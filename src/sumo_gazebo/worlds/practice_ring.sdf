<?xml version="1.0"?>

<sdf version="1.8">
  <world name="sumo_practice">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <gui fullscreen="0">
      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.55 0.6</ambient_light>
        <background_color>0.1 0.11 0.16</background_color>
        <camera_pose>-4.2 -3.4 2.8 0 0.45 0.68</camera_pose>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>false</step>
        <start_paused>false</start_paused>
      </plugin>
    </gui>

    <scene>
      <ambient>0.5 0.5 0.55 1</ambient>
      <background>0.1 0.11 0.16 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.35 0.25 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material><ambient>0.25 0.28 0.34 1</ambient><diffuse>0.25 0.28 0.34 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dohyo">
      <static>true</static>
      <link name="link">
        <visual name="edge_band_v"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>2.0</radius><length>0.3</length></cylinder></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual><collision name="edge_band_c"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>2.0</radius><length>0.3</length></cylinder></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="top_sand_v"><pose>0 0 0.29 0 0 0</pose><geometry><cylinder><radius>1.98</radius><length>0.02</length></cylinder></geometry><material><ambient>0.86 0.74 0.52 1</ambient><diffuse>0.86 0.74 0.52 1</diffuse></material></visual><visual name="line_white_v"><pose>0 0 0.302 0 0 0</pose><geometry><cylinder><radius>1.92</radius><length>0.004</length></cylinder></geometry><material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual><visual name="line_inner_v"><pose>0 0 0.304 0 0 0</pose><geometry><cylinder><radius>1.84</radius><length>0.004</length></cylinder></geometry><material><ambient>0.86 0.74 0.52 1</ambient><diffuse>0.86 0.74 0.52 1</diffuse></material></visual><visual name="start_line_a_v"><pose>-0.55 0 0.306 0 0 0</pose><geometry><box><size>0.06 0.7 0.004</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material></visual><visual name="start_line_b_v"><pose>0.55 0 0.306 0 0 0</pose><geometry><box><size>0.06 0.7 0.004</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material></visual>
      </link>
    </model>
    <model name="dummy">
      <pose>0.7 0 0.6599999999999999 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>15</mass>
          <inertia><ixx>0.85</ixx><iyy>0.85</iyy><izz>0.47</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="body">
          <geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry>
          <surface><friction><ode><mu>0.35</mu><mu2>0.35</mu2></ode></friction></surface>
        </collision>
        <visual name="bag_v"><pose>0 0 0 0 0 0</pose><geometry><cylinder><radius>0.25</radius><length>0.7</length></cylinder></geometry><material><ambient>0.96 0.96 0.96 1</ambient><diffuse>0.96 0.96 0.96 1</diffuse></material></visual>
        <visual name="band_low_v"><pose>0 0 -0.2 0 0 0</pose><geometry><cylinder><radius>0.252</radius><length>0.12</length></cylinder></geometry><material><ambient>0.86 0.08 0.1 1</ambient><diffuse>0.86 0.08 0.1 1</diffuse></material></visual>
        <visual name="band_high_v"><pose>0 0 0.2 0 0 0</pose><geometry><cylinder><radius>0.252</radius><length>0.12</length></cylinder></geometry><material><ambient>0.86 0.08 0.1 1</ambient><diffuse>0.86 0.08 0.1 1</diffuse></material></visual>
        <visual name="target_v"><pose>0.25 0 0.05 0 1.5707963 0</pose><geometry><cylinder><radius>0.08</radius><length>0.01</length></cylinder></geometry><material><ambient>0.98 0.78 0.05 1</ambient><diffuse>0.98 0.78 0.05 1</diffuse><emissive>0.98 0.78 0.05 1</emissive></material></visual>
      </link>
    </model>
  </world>
</sdf>
